{
  "name": "trafikken-poc",
  "version": "0.1.0",
  "private": true,
  "description": "POC: daily Instagram post with tonight's northern lights conditions per place in Northern Norway (NOAA Kp + MET Norway cloud cover)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "tsx src/cli/generate.tsx",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "publish": "tsx src/cli/publish.ts",
    "control": "tsx src/cli/control.ts",
    "dashboard": "tsx src/cli/dashboard.ts",
    "autopilot": "tsx src/cli/autopilot.ts",
    "brand": "tsx src/cli/brand.tsx",
    "insights": "tsx src/cli/insights.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ffmpeg-static": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "react": "^19.3.1",
    "satori": "^0.63.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
